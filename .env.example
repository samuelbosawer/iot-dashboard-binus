APP_NAME="Taman Pintar IoT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://iotbinus.projectbos.web.id
APP_TIMEZONE=Asia/Jakarta

MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_WEBSOCKET_URL=wss://broker.hivemq.com:8884/mqtt
MQTT_TOPIC_SENSOR=binus/garden/sensor/data
MQTT_TOPIC_PUMP=binus/garden/pump/cmd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (docker-compose.yml): the app container reaches MySQL by its service name "mysql".
# From the host (HeidiSQL, DBeaver, php artisan outside Docker) use DB_HOST=127.0.0.1 instead.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=iot_dashboard
DB_USERNAME=iot_user
DB_PASSWORD=iot123

# InfluxDB 2.7 (docker-compose.yml).
#   Inside Docker (the app container): INFLUXDB_URL=http://influxdb:8086
#   From the host (browser UI, scripts):  http://localhost:8086  (login admin / BinusIoT123!)
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=binus
INFLUXDB_BUCKET=iot_sensors
INFLUXDB_TOKEN=binus-iot-super-secret-token-12345

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
